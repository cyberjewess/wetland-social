# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth Configuration
OAUTH_CLIENT_ID=http://localhost:3000/client-metadata.json
OAUTH_PRIVATE_KEY_PATH=/absolute/path/to/wetland-social/keys/private-key.pem
SESSION_SECRET=your-random-secret-key-here

# AT Protocol PDS
NEXT_PUBLIC_PDS_URL=https://bsky.social

# Optional: Local PDS for development
# DEV_PDS_URL=http://localhost:2583

# Redis Configuration (for OAuth state persistence)
# Leave empty to use in-memory storage (dev only)
# Docker Compose: redis://redis:6379
# Local Redis: redis://localhost:6379
REDIS_URL=
